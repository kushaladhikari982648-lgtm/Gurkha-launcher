<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/fragment_menu_main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <ScrollView android:id="@+id/home_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:id="@+id/play_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
      <include android:id="@+id/view_account" layout="@layout/view_account" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginBottom="16dp" />
      <TextView style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mc_adventure" android:textSize="26sp" android:fontFamily="sans-serif-medium" />
      <TextView style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mc_tagline" android:textSize="13sp" android:textColor="#A4B1A7" android:paddingTop="6dp" android:paddingBottom="20dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:baselineAligned="false">
        <LinearLayout android:id="@+id/play_buttons_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/background_card" android:padding="18dp">
          <TextView style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mc_profile" android:textSize="12sp" android:textColor="@color/settings_category" android:paddingBottom="16dp" />
          <LinearLayout android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/mc_button" android:padding="10dp" android:focusable="true" android:clickable="true">
            <ImageView android:id="@+id/version_icon" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/modern_cube" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="0dp">
              <TextView android:id="@+id/version_name" style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:text="@string/version_no_versions" />
              <TextView android:id="@+id/version_info" style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#A4B1A7" android:visibility="gone" />
            </LinearLayout>
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginVertical="14dp">
            <TextView android:id="@+id/renderer_summary" style="@style/MinecraftLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="54dp" android:gravity="center_vertical" android:background="@drawable/modern_stat" android:padding="12dp" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/memory_summary" style="@style/MinecraftLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="54dp" android:gravity="center_vertical" android:background="@drawable/modern_stat" android:padding="12dp" />
          </LinearLayout>
          <Button android:id="@+id/play_button" style="@style/ModernPrimary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/modern_launch" android:layout_marginBottom="6dp" />
          <Button android:id="@+id/manager_profile_button" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mc_edit_profile" android:layout_marginBottom="6dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/background_card" android:padding="18dp" android:layout_marginTop="16dp">
          <TextView style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/modern_make_yours" android:textSize="18sp" android:paddingBottom="14dp" />
          <Button android:id="@+id/quick_versions" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mc_versions" android:layout_marginBottom="6dp" />
          <Button android:id="@+id/quick_mods" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mc_mods" android:layout_marginBottom="6dp" />
          <Button android:id="@+id/quick_tools" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mc_tools" android:layout_marginBottom="6dp" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:id="@+id/tools_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/background_card" android:padding="18dp" android:visibility="gone">
        <TextView style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mc_tools" android:textSize="18sp" android:paddingBottom="12dp" />
        <Button android:id="@+id/custom_control_button" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/custom_control_title" android:layout_marginBottom="6dp" />
        <Button android:id="@+id/open_main_dir_button" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_open_main_dir" android:layout_marginBottom="6dp" />
        <Button android:id="@+id/install_jar_button" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_install_jar_file" android:layout_marginBottom="6dp" />
        <Button android:id="@+id/share_logs_button" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/main_share_logs" android:layout_marginBottom="6dp" />
        <FrameLayout android:id="@+id/about_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@drawable/mc_button" android:clickable="true" android:focusable="true">
          <TextView android:id="@+id/about_text" style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center" android:padding="12dp" />
        </FrameLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/background_card" android:padding="18dp">
        <TextView style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/modern_light_touch" android:textSize="15sp" />
        <TextView android:id="@+id/low_end_status" style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="6dp" android:textColor="#A4B1A7" />
        <Button android:id="@+id/performance_button" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/modern_performance" android:layout_marginBottom="6dp" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
  <LinearLayout android:id="@+id/launcher_menu" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/background_overlay" android:padding="6dp">
    <Button android:id="@+id/home_button" style="@style/ModernBottomNav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableTop="@drawable/modern_home" android:text="@string/mc_home" />
    <Button android:id="@+id/versions_button" style="@style/ModernBottomNav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableTop="@drawable/modern_versions" android:text="@string/mc_versions" />
    <Button android:id="@+id/mods_button" style="@style/ModernBottomNav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableTop="@drawable/modern_mods" android:text="@string/mc_mods" />
    <Button android:id="@+id/settings_button" style="@style/ModernBottomNav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableTop="@drawable/modern_settings" android:text="@string/mc_settings" />
    <Button android:id="@+id/tools_button" style="@style/ModernBottomNav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableTop="@drawable/modern_tools" android:text="@string/mc_tools" />
  </LinearLayout>
</LinearLayout>