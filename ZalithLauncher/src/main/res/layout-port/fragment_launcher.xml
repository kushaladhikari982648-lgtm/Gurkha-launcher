<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/fragment_menu_main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp">
  <ScrollView android:id="@+id/home_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:id="@+id/play_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/background_card" android:padding="10dp" android:layout_marginBottom="8dp">
        <include android:id="@+id/view_account" layout="@layout/view_account" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginBottom="6dp" />
        <TextView style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mc_adventure" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
        <TextView style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mc_tagline" android:textSize="11sp" android:textColor="#B8D4C9" android:paddingTop="2dp" android:paddingBottom="6dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
          <Button android:id="@+id/discord_button" style="@style/ModernNav" android:layout_width="0dp" android:layout_height="34dp" android:minHeight="34dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:drawableStart="@drawable/modern_discord" android:text="@string/mc_discord" />
          <Button android:id="@+id/orientation_toggle_button" style="@style/ModernNav" android:layout_width="0dp" android:layout_height="34dp" android:minHeight="34dp" android:layout_weight="1" android:drawableStart="@drawable/modern_rotate" android:text="@string/modern_switch_landscape" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:baselineAligned="false">
        <LinearLayout android:id="@+id/play_buttons_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/background_card" android:padding="12dp">
          <TextView style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mc_profile" android:textSize="11sp" android:textColor="@color/settings_category" android:paddingBottom="6dp" />
          <LinearLayout android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/mc_button" android:padding="8dp" android:focusable="true" android:clickable="true">
            <ImageView android:id="@+id/version_icon" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/modern_cube" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="0dp">
              <TextView android:id="@+id/version_name" style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:singleLine="true" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:text="@string/version_no_versions" />
              <TextView android:id="@+id/version_info" style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:textColor="#B8D4C9" android:visibility="gone" />
            </LinearLayout>
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginVertical="8dp">
            <TextView android:id="@+id/renderer_summary" style="@style/MinecraftLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="38dp" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:gravity="center_vertical" android:background="@drawable/modern_stat" android:padding="8dp" android:layout_marginEnd="6dp" />
            <TextView android:id="@+id/memory_summary" style="@style/MinecraftLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="38dp" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:gravity="center_vertical" android:background="@drawable/modern_stat" android:padding="8dp" />
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/play_button" style="@style/ModernPrimary" android:layout_width="0dp" android:layout_height="46dp" android:text="@string/modern_launch" android:layout_weight="1" android:minHeight="46dp" android:textSize="15sp" />
            <ImageButton android:id="@+id/manager_profile_button" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="8dp" android:background="@drawable/mc_button" android:src="@drawable/modern_settings" android:padding="12dp" android:contentDescription="@string/mc_edit_profile" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:id="@+id/tools_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:background="@drawable/background_card" android:padding="12dp" android:visibility="gone">
        <TextView style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mc_tools" android:textSize="15sp" android:paddingBottom="6dp" />
        <Button android:id="@+id/custom_control_button" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="38dp" android:text="@string/custom_control_title" android:layout_marginBottom="4dp" />
        <Button android:id="@+id/open_main_dir_button" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="38dp" android:text="@string/main_open_main_dir" android:layout_marginBottom="4dp" />
        <Button android:id="@+id/install_jar_button" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="38dp" android:text="@string/main_install_jar_file" android:layout_marginBottom="4dp" />
        <Button android:id="@+id/share_logs_button" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="38dp" android:text="@string/main_share_logs" android:layout_marginBottom="4dp" />
        <Button android:id="@+id/wardrobe_button" style="@style/MinecraftNav" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="38dp" android:text="@string/wardrobe_title" android:layout_marginBottom="4dp" />
        <FrameLayout android:id="@+id/about_button" android:layout_width="match_parent" android:layout_height="38dp" android:minHeight="38dp" android:background="@drawable/mc_button" android:clickable="true" android:focusable="true">
          <TextView android:id="@+id/about_text" style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="match_parent" android:minHeight="38dp" android:gravity="center" android:padding="6dp" />
        </FrameLayout>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
  <LinearLayout android:id="@+id/launcher_menu" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/mc_panel" android:padding="6dp" android:layout_marginTop="6dp" android:layout_marginBottom="42dp">
    <Button android:id="@+id/home_button" style="@style/ModernBottomNav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableTop="@drawable/modern_home" android:text="@string/mc_home" />
    <Button android:id="@+id/versions_button" style="@style/ModernBottomNav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableTop="@drawable/modern_versions" android:text="@string/mc_versions" />
    <Button android:id="@+id/mods_button" style="@style/ModernBottomNav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableTop="@drawable/modern_mods" android:text="@string/mc_mods" />
    <Button android:id="@+id/settings_button" style="@style/ModernBottomNav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableTop="@drawable/modern_settings" android:text="@string/mc_settings" />
    <Button android:id="@+id/tools_button" style="@style/ModernBottomNav" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableTop="@drawable/modern_tools" android:text="@string/mc_tools" />
  </LinearLayout>
</LinearLayout>
