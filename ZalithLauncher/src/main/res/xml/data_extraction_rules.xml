<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules). Everything else is still backed up / transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Microsoft / third-party login tokens must never be copied into backups -->
        <exclude domain="file" path="accounts/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="accounts/" />
    </device-transfer>
</data-extraction-rules>
