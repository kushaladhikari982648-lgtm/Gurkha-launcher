<resources>
  <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
    <item name="windowNoTitle">true</item>
    <item name="windowActionBar">false</item>
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:statusBarColor">@color/background_status_bar</item>
    <item name="android:navigationBarColor">@color/background_app</item>
    <item name="android:scrollbarThumbHorizontal">@color/background_menu_element</item>
    <item name="android:scrollbarThumbVertical">@color/background_menu_element</item>
    <item name="android:textSize">@dimen/_12ssp</item>
    <item name="android:textColorPrimary">@color/primary_text</item>
    <item name="android:textColorSecondary">#C8CEBC</item>
    <item name="android:textColorHint">#ABB59B</item>
    <item name="colorAccent">@color/menu_progress</item>
    <item name="android:colorAccent">@color/menu_progress</item>
    <item name="colorControlNormal">@color/icon_color</item>
    <item name="colorControlActivated">@color/menu_progress</item>
    <item name="android:windowBackground">@color/background_app</item>
    <item name="buttonStyle">@style/MinecraftGlobalButton</item>
    <item name="android:buttonStyle">@style/MinecraftGlobalButton</item>
    <item name="seekBarStyle">@style/MinecraftSeekBar</item>
    <item name="android:seekBarStyle">@style/MinecraftSeekBar</item>
    <item name="android:switchStyle">@style/MinecraftSwitch</item>
  </style>
  <style name="CustomDialogStyle" parent="Theme.AppCompat.Dialog">
    <item name="android:windowBackground">@drawable/dialog_background</item>
    <item name="android:scrollbarThumbHorizontal">@color/background_menu_element</item>
    <item name="android:scrollbarThumbVertical">@color/background_menu_element</item>
    <item name="android:textColorPrimary">@color/primary_text</item>
    <item name="android:textColorSecondary">#C8CEBC</item>
    <item name="android:textColorHint">#ABB59B</item>
    <item name="colorAccent">@color/menu_progress</item>
    <item name="android:colorAccent">@color/menu_progress</item>
    <item name="colorControlNormal">@color/icon_color</item>
    <item name="colorControlActivated">@color/menu_progress</item>
    <item name="buttonStyle">@style/MinecraftGlobalButton</item>
    <item name="android:buttonStyle">@style/MinecraftGlobalButton</item>
    <item name="seekBarStyle">@style/MinecraftSeekBar</item>
    <item name="android:seekBarStyle">@style/MinecraftSeekBar</item>
    <item name="android:switchStyle">@style/MinecraftSwitch</item>
  </style>
  <style name="CustomAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
    <item name="android:windowBackground">@drawable/dialog_background</item>
    <item name="android:scrollbarThumbHorizontal">@color/background_menu_element</item>
    <item name="android:scrollbarThumbVertical">@color/background_menu_element</item>
    <item name="android:textColorPrimary">@color/primary_text</item>
    <item name="android:textColorSecondary">#C8CEBC</item>
    <item name="android:textColorHint">#ABB59B</item>
    <item name="colorAccent">@color/menu_progress</item>
    <item name="android:colorAccent">@color/menu_progress</item>
    <item name="colorControlNormal">@color/icon_color</item>
    <item name="colorControlActivated">@color/menu_progress</item>
    <item name="buttonStyle">@style/MinecraftGlobalButton</item>
    <item name="android:buttonStyle">@style/MinecraftGlobalButton</item>
    <item name="seekBarStyle">@style/MinecraftSeekBar</item>
    <item name="android:seekBarStyle">@style/MinecraftSeekBar</item>
    <item name="android:switchStyle">@style/MinecraftSwitch</item>
  </style>
</resources>
