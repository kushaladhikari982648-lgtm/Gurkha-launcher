<resources>
  <style name="MinecraftNav" parent="Widget.AppCompat.Button">
    <item name="android:background">@drawable/mc_button</item>
    <item name="backgroundTint">@null</item>
    <item name="android:backgroundTint">@null</item>
    <item name="android:textColor">@color/primary_text</item>
    <item name="android:textSize">14sp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:minWidth">0dp</item>
    <item name="android:padding">8dp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
  </style>
  <style name="MinecraftLabel">
    <item name="android:textColor">@color/primary_text</item>
    <item name="android:textSize">14sp</item>
  </style>
  <string name="mc_home">Home</string>
  <string name="mc_versions">Versions</string>
  <string name="mc_mods">Mods</string>
  <string name="mc_settings">Settings</string>
  <string name="mc_adventure">Your next adventure.</string>
  <string name="mc_tagline">A little less setup. A little more Minecraft.</string>
  <string name="mc_profile">Selected profile</string>
  <string name="mc_renderer">Renderer: %1$s</string>
  <string name="mc_memory">RAM limit: %1$d MB</string>
  <string name="mc_edit_profile">Edit profile</string>
  <string name="mc_low_end_on">Low-end mode: on</string>
  <string name="mc_low_end_off">Low-end mode: off</string>
  <string name="mc_tools">Tools</string>
  <string name="mc_java_edition">JAVA EDITION</string>
  <style name="MinecraftGlobalButton" parent="Widget.AppCompat.Button">
    <item name="android:background">@drawable/button_background</item>
    <item name="backgroundTint">@null</item>
    <item name="android:backgroundTint">@null</item>
    <item name="android:textColor">@color/primary_text</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:minHeight">48dp</item>
  </style>
  <style name="MinecraftSeekBar" parent="Widget.AppCompat.SeekBar">
    <item name="android:thumb">@drawable/mc_slider_thumb</item>
    <item name="android:progressDrawable">@drawable/mc_slider_track</item>
    <item name="android:minHeight">48dp</item>
  </style>
  <style name="MinecraftSwitch" parent="@android:style/Widget.Material.CompoundButton.Switch">
    <item name="android:thumb">@drawable/mc_toggle_thumb</item>
    <item name="android:track">@drawable/mc_toggle_track</item>
    <item name="android:switchMinWidth">52dp</item>
    <item name="android:thumbTint">@null</item>
    <item name="android:trackTint">@null</item>
  </style>
  <string name="mc_auto_saved">Changes are saved automatically</string>

  <style name="ModernNav" parent="MinecraftNav">
    <item name="android:gravity">start|center_vertical</item>
    <item name="android:paddingHorizontal">12dp</item>
    <item name="android:drawablePadding">10dp</item>
    <item name="android:textSize">13sp</item>
    <item name="android:stateListAnimator">@null</item>
  </style>
  <style name="ModernBottomNav" parent="MinecraftNav">
    <item name="android:textSize">11sp</item>
    <item name="android:padding">4dp</item>
    <item name="android:drawablePadding">4dp</item>
    <item name="android:stateListAnimator">@null</item>
  </style>
  <style name="ModernPrimary" parent="MinecraftNav">
    <item name="android:background">@drawable/mc_play</item>
    <item name="android:textColor">#18301B</item>
    <item name="android:textSize">16sp</item>
    <item name="android:stateListAnimator">@null</item>
  </style>
  <string name="modern_workspace">WORKSPACE</string>
  <string name="modern_make_yours">Make it yours</string>
  <string name="modern_subtitle">Less clutter. Everything where you expect it.</string>
  <string name="modern_performance">Performance settings</string>
  <string name="modern_light_touch">A lighter touch.</string>
  <string name="modern_light_desc">Limit background work without changing your saved RAM limit.</string>
  <string name="modern_launch">Launch game</string>
  <string name="modern_add_version">Add a version</string>
  <string name="modern_downloads">Downloads</string>
  <string name="modern_switch_portrait">Portrait mode</string>
  <string name="modern_switch_landscape">Landscape mode</string>
  <string name="modern_toggle_orientation">Switch orientation</string>
</resources>
