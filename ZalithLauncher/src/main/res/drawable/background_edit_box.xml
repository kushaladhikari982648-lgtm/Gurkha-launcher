<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled wins even when a view remains selected or checked. -->
    <item android:drawable="@drawable/background_edit_box_disabled" android:state_enabled="false" />
    <item android:state_checked="true" android:drawable="@drawable/background_edit_box_selected"/>
    <item android:state_selected="true" android:drawable="@drawable/background_edit_box_selected"/>
    <item android:state_focused="true" android:drawable="@drawable/background_edit_box_selected"/>
    <item android:state_pressed="true" android:drawable="@drawable/background_edit_box_selected"/>
    <item android:drawable="@drawable/background_edit_box_unselected"/>
</selector>
