<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:id="@android:id/background" android:gravity="center_vertical" android:height="8dp">
    <shape>
      <solid android:color="#303A32" />
      <stroke android:width="1dp" android:color="#7C876D" />
      <corners android:radius="24dp" />
    </shape>
  </item>
  <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="8dp">
    <clip>
      <shape>
        <solid android:color="#B5E5A7" />
        <corners android:radius="24dp" />
      </shape>
    </clip>
  </item>
</layer-list>