<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
  <LinearLayout android:id="@+id/settings_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView style="@style/MinecraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mc_settings" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:paddingHorizontal="8dp" />
    <HorizontalScrollView android:id="@+id/settings_tab_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" android:scrollbars="none">
      <LinearLayout android:id="@+id/settings_tab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/tab_video" style="@style/MinecraftNav" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="88dp" android:paddingHorizontal="16dp" android:layout_marginEnd="6dp" android:text="@string/setting_category_video" />
        <Button android:id="@+id/tab_control" style="@style/MinecraftNav" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="88dp" android:paddingHorizontal="16dp" android:layout_marginEnd="6dp" android:text="@string/setting_category_control" />
        <Button android:id="@+id/tab_game" style="@style/MinecraftNav" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="88dp" android:paddingHorizontal="16dp" android:layout_marginEnd="6dp" android:text="@string/setting_category_game" />
        <Button android:id="@+id/tab_launcher" style="@style/MinecraftNav" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="88dp" android:paddingHorizontal="16dp" android:layout_marginEnd="6dp" android:text="@string/setting_category_launcher" />
        <Button android:id="@+id/tab_experimental" style="@style/MinecraftNav" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="88dp" android:paddingHorizontal="16dp" android:layout_marginEnd="6dp" android:text="@string/setting_category_experimental" />
      </LinearLayout>
    </HorizontalScrollView>
  </LinearLayout>
  <androidx.viewpager2.widget.ViewPager2 android:id="@+id/settings_viewpager" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
  <TextView android:id="@+id/settings_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:gravity="center" android:text="@string/mc_auto_saved" android:textSize="12sp" android:textColor="#A4B1A7" />
</LinearLayout>